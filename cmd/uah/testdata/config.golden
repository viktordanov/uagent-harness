workspace:    $ROOT/ws (flag)
user file:    $ROOT/config/uagent/config.toml (read)
project file: $ROOT/ws/.uagent/config.toml (read)

KEY                                               VALUE                         SOURCE
provider                                          openai-codex                  default
model                                             gpt-6-luna                    user file
effort                                            medium                        project file
timeout                                           10m0s                         flag
max_disk                                          5G                            default
engine                                            embedded                      default
fast                                              true                          user file
permission_mode                                   read-only                     env
sandbox_mode                                      read-only                     env
approval_policy                                   on-request                    default
model_context_window                              272000                        default
instructions.enabled                              true                          default
approvals_reviewer                                user                          default
review.model                                      codex-auto-review             default
review.effort                                     low                           default
review.timeout                                    1m30s                         default
review.policy_file                                Codex's policy                default
auto_compact_percent                              80                            project file
model_auto_compact_token_limit                    0                             default
compact_model                                     gpt-6-luna                    default
compact_effort                                    medium                        default
compact_prompt                                    Codex's                       default
experimental_compact_prompt_file                  ""                            default
compact_user_message_max_tokens                   20000                         default
instructions.max_bytes                            32768                         default
project_doc_max_bytes                             32768                         default
project_doc_fallback_filenames                    []                            default
project_root_markers                              [.git]                        default
sandbox_workspace_write.network_access            false                         default
sandbox_workspace_write.writable_roots            []                            default
approvals.allow                                   [go test, make]               user file + project file
approvals.forbid                                  []                            default
shell_environment_policy.inherit                  all                           default
shell_environment_policy.ignore_default_excludes  true                          default
shell_environment_policy.exclude                  []                            default
shell_environment_policy.include_only             []                            default
